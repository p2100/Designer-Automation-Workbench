{
  "schemaVersion": 1,
  "version": "1.1.0",
  "authority": "This file owns module field projections; core/module-data.md owns the reading, media and verification policy",
  "knownFieldPolicy": "Use knownConditional fields by default for the selected module. Omission needs a purpose/capacity reason. Unknown values are never fabricated.",
  "stylePolicy": "Business fields and relationships are shared; imagery, colours, buttons and layout are original to each site.",
  "fieldSets": {
    "appIdentity": {"required":["app.id","app.name","app.icon","action.detailRoute"],"knownConditional":["app.primaryCategory","app.platforms"]},
    "discoveryCard": {"required":["app.id","app.name","app.icon","app.primaryCategory","action.detailRoute"],"knownConditional":["rating.value","rating.platform","rating.source","downloads.label","downloads.platform"],"roleOptional":["price.label","price.platform","publisher","oneLineBenefit"],"notDefault":["longDescription","unverifiedRank","inventedReview"]},
    "rating": {"requiredIfShown":["value","platform","source","observedAt"],"knownConditional":["ratingCount"]},
    "downloads": {"requiredIfShown":["label","platform","source","observedAt"],"policy":"Preserve source ranges such as 100M+; no growth claims without history"},
    "editorialMedia": {"requiredIfUsed":["file","role","subject","sourceKind","provenance","aspectAndCropPlan"],"roles":["banner-artwork","article-cover"],"neverClaim":"official product screenshot or output made by the app"},
    "productScreenshot": {"required":["file","appId","platform","source","originalRatio","alt"],"neverSubstitute":["generatedInterface","unrelatedPromotionalArt"]},
    "channel": {"required":["appId","platform","type","label","target","source","verificationLevel"],"knownConditional":["format","version","size","minimumOs","expiry"],"notDefault":["scanBadge","downloadSuccess"]},
    "articleCard": {"required":["article.id","title","type","articleRoute"],"knownConditional":["editorialCover","publishedAt","updatedAt"],"roleOptional":["shortExcerpt","associatedApps","actualByline"]},
    "category": {"required":["id","name","route","actualMembership"],"knownConditional":["uniqueAppCount"],"roleOptional":["shortPurpose","categoryArtwork"]}
  },
  "modules": [
    {"id":"shared.header","pages":["*"],"required":true,"purpose":"Identify the site and provide actual navigation","requiredFields":["brand.name","brand.mark","actualNavigation"],"conditionalFields":["workingSearchEntry","realCategoryNavigation"],"relationship":"Brand returns home; navigation leads to actual routes"},
    {"id":"shared.footer","pages":["*"],"required":true,"purpose":"Site identity and information access","requiredFields":["brand.name","aboutRoute","contactRoute","privacyRoute","disclaimerRoute"],"relationship":"Matches the same site; does not invent an operator or contact"},
    {"id":"home.banner","pages":["home"],"required":true,"purpose":"Recommend specific apps through a strong first-view proposition","uses":["appIdentity","rating","downloads"],"requiredFields":["featuredAppId","editorialHeadline","usefulBenefit","appIdentity","action.detailRoute","selectedMediaVariant"],"knownConditional":["app.primaryCategory","rating","downloads","price"],"variants":{"image-led":{"requires":["independentBannerArtwork","separateAppIcon"],"mediaRole":"banner-artwork"},"identity-led":{"requires":["deliberateAppIdentityComposition"],"mediaRole":"app-icon","note":"Must not be claimed as independent banner artwork"}},"relationship":"Artwork and app information form one recommendation; slide controls correspond to actual slides"},
    {"id":"home.secondary-picks","pages":["home"],"required":false,"purpose":"Offer a small set of alternatives beside or after the primary recommendation","uses":["discoveryCard"],"requiredFields":["selectionReason","uniqueAppIds"],"relationship":"Secondary visual priority; each item enters its own detail"},
    {"id":"home.recommendations","pages":["home"],"required":true,"purpose":"Help visitors compare a considered selection quickly","uses":["discoveryCard"],"requiredFields":["moduleTitle","editorialSelectionOrDataCriteria","uniqueAppIds"],"relationship":"Name/icon lead; category and known decision metrics support; action stays with the same app"},
    {"id":"home.ranked-list","pages":["home"],"required":false,"purpose":"Compare a stated metric within a stated collection","uses":["appIdentity","rating","downloads"],"requiredFields":["scope","rankingMetric","sortDefinition","position","appIds","metricValues"],"relationship":"Display the actual sorting metric; no unverified trend arrows or global-popularity claim"},
    {"id":"home.purpose-groups","pages":["home"],"required":false,"purpose":"Browse by an actual use case","uses":["appIdentity"],"requiredFields":["groupPurpose","matchingAppIds","categoryOrCollectionRoute"],"relationship":"Group explains the shared task; compact item may omit repeated category already given by the group"},
    {"id":"home.tools-feature","pages":["home"],"required":false,"purpose":"Explain why selected tools are useful","uses":["discoveryCard"],"requiredFields":["matchingAppIds","oneUsefulBenefitPerApp"],"knownConditional":["rating","downloads"],"relationship":"Benefit belongs to the app; avoid the same generic description on every item"},
    {"id":"home.games","pages":["home"],"required":false,"purpose":"Discover downloadable game apps","uses":["discoveryCard"],"requiredFields":["gameAppIds","downloadDiscoveryAction"],"knownConditional":["price","rating","downloads"],"relationship":"Action enters app detail, not an unimplemented web-game runtime"},
    {"id":"home.updates","pages":["home"],"required":false,"purpose":"Show actual platform updates in the collection","uses":["discoveryCard"],"requiredFields":["appIds","updatedAt","updatePlatform","sortDefinition"],"knownConditional":["version"],"relationship":"Update date is not initial release date; no invented NEW status"},
    {"id":"home.articles","pages":["home"],"required":true,"purpose":"Open useful editorial reading","uses":["articleCard"],"requiredFields":["actualArticleIds","editorialCoverForImageLedCards"],"relationship":"Image/heading/excerpt refer to the same article; cover is not an arbitrary product screenshot"},
    {"id":"home.categories","pages":["home"],"required":true,"purpose":"Choose a real app category","uses":["category"],"requiredFields":["actualCategoryIds"],"relationship":"Count matches unique members; destination is the corresponding result list"},
    {"id":"article.header","pages":["article"],"required":true,"purpose":"Identify the topic and reading promise","requiredFields":["title","articleType","usefulIntroduction"],"knownConditional":["actualByline","publishedAt","updatedAt"]},
    {"id":"article.cover","pages":["article"],"required":false,"purpose":"Visually frame the actual topic","uses":["editorialMedia"],"requiredFields":["topicMatchedCover"],"relationship":"Editorial media and real product evidence remain distinguishable"},
    {"id":"article.app-context","pages":["article"],"required":true,"purpose":"Bind the discussion to real apps","uses":["appIdentity"],"knownConditional":["rating","price"],"relationship":"Associated card links to the exact app detail"},
    {"id":"article.body","pages":["article"],"required":true,"purpose":"Deliver the chosen review/tutorial/collection/comparison","requiredFields":["meaningfulHeadings","substantiveBody","sourceBoundClaims"],"conditionalFields":["actualStepsForTutorial","comparisonBasisForComparison","selectionReasonForCollection","evidenceForReviewJudgments"],"relationship":"Does not duplicate detail text or invent hands-on tests"},
    {"id":"article.inline-media","pages":["article"],"required":false,"purpose":"Support a specific explanation","uses":["productScreenshot"],"relationship":"Adjacent explanation and platform correspond to the media"},
    {"id":"article.related","pages":["article"],"required":true,"purpose":"Continue reading or return to discovery","uses":["articleCard","appIdentity"],"requiredFields":["relatedContentOrClearReturn"],"relationship":"Actual topical relation, not filler"},
    {"id":"category.header","pages":["category"],"required":true,"purpose":"Clarify the selected app group","uses":["category"],"requiredFields":["selectedCategoryIdentity"],"knownConditional":["trueResultCount"]},
    {"id":"category.navigation","pages":["category"],"required":true,"purpose":"Change category or return","requiredFields":["actualCategoryOrReturnTargets","currentSelection"]},
    {"id":"category.list","pages":["category"],"required":true,"purpose":"Compare matching apps","uses":["discoveryCard"],"requiredFields":["membershipFilteredAppIds"],"relationship":"Rows share one useful information capacity; known metrics are not replaced by generic prose"},
    {"id":"category.controls","pages":["category"],"required":false,"purpose":"Manage a real result set","requiredFields":["actualSortFilterOrPaginationState"],"relationship":"Counts and boundaries reflect the actual filtered data"},
    {"id":"category.empty","pages":["category"],"required":true,"purpose":"Recover from no matches","requiredFields":["selectedCategory","emptyExplanation","workingRecovery"]},
    {"id":"detail.identity","pages":["detail"],"required":true,"purpose":"Confirm the current app","uses":["appIdentity","rating","downloads"],"requiredFields":["fullReadableName","realIcon","category","platforms"],"knownConditional":["publisher","rating","ratingCount","downloads","price"]},
    {"id":"detail.facts","pages":["detail"],"required":true,"purpose":"Evaluate known requirements and listing facts","requiredFields":["platformBoundFactGroups"],"knownConditional":["publisher","version","size","updatedAt","minimumOs","ageRating","price","storeCategory","rating","ratingCount","downloads"],"relationship":"Unknown values are omitted/marked unknown; never borrow the other platform's values"},
    {"id":"detail.screenshots","pages":["detail"],"required":true,"purpose":"Show the actual product","uses":["productScreenshot"],"requiredFields":["realScreenshots","usableGalleryAndBoundaryStates"],"relationship":"Correct app/platform; original aspect preserved; no fake forward control at the end"},
    {"id":"detail.description","pages":["detail"],"required":true,"purpose":"Explain what the app does and whom it fits","requiredFields":["appSpecificIntroduction","actualUseCases","knownConditions"],"relationship":"Original substantive wording rather than repeated generic templates"},
    {"id":"detail.features","pages":["detail"],"required":true,"purpose":"Make core capabilities understandable","requiredFields":["sourceBoundCoreFunctions"],"relationship":"Specific useful functions, not filler instructions to read another page"},
    {"id":"detail.acquisition","pages":["detail"],"required":true,"purpose":"Enter the correct acquisition flow","requiredFields":["currentAppVersionRoute","honestAvailability"],"conditionalFields":["exactOfficialStoreShortcuts"],"relationship":"Primary action belongs to current app and reaches version"},
    {"id":"detail.related-apps","pages":["detail"],"required":true,"purpose":"Explore relevant alternatives","uses":["discoveryCard"],"requiredFields":["actualRelationship","excludeCurrentApp"],"relationship":"Never squeeze the app name to make space for status pills"},
    {"id":"detail.optional-evidence","pages":["detail"],"required":false,"purpose":"Supply additional real evidence","requiredFields":["basisForEveryDisplayedReviewRatingUpdateOrFaqClaim"],"relationship":"No invented user reviews or security tests"},
    {"id":"version.identity","pages":["version"],"required":true,"purpose":"Confirm continuity from detail","uses":["appIdentity"],"requiredFields":["fullReadableName","icon","platforms","backToDetail"]},
    {"id":"version.channels","pages":["version"],"required":true,"purpose":"Choose an actual way to get the current app","uses":["channel"],"requiredFields":["actualAvailableChannels","distinctPlatformAndSourceLabels"],"relationship":"No forced three-channel completeness; no placeholder targets"},
    {"id":"version.file-facts","pages":["version"],"required":false,"purpose":"Explain the specific file option","uses":["channel"],"requiredFields":["actualFileSource","knownFormat"],"knownConditional":["version","size","compatibility","expiry"]},
    {"id":"version.instructions","pages":["version"],"required":true,"purpose":"Explain the real next step and recover from failure","requiredFields":["truthfulActionState","returnOrRetry"],"conditionalFields":["sourceSpecificNecessaryInstructions"],"relationship":"Link selection is not download/installation success"},
    {"id":"version.related","pages":["version"],"required":true,"purpose":"Provide secondary discovery","uses":["discoveryCard"],"requiredFields":["relevantAppsAndReturn"],"relationship":"Secondary to the current app channel selection"},
    {"id":"search.query","pages":["search"],"required":true,"purpose":"State what is being searched","requiredFields":["actualInput","queryEcho","submitAndClear"]},
    {"id":"search.results","pages":["search"],"required":true,"purpose":"Compare actual matches","uses":["discoveryCard"],"requiredFields":["realMatchingAppIds","trueResultCount"]},
    {"id":"search.empty","pages":["search"],"required":true,"purpose":"Recover from an empty or failed search","requiredFields":["query","emptyOrErrorState","workingRecovery"]},
    {"id":"information.about","pages":["information"],"when":"about","required":true,"requiredFields":["realSitePurpose","truthfulRelationshipToPublishers"]},
    {"id":"information.contact","pages":["information"],"when":"contact","required":true,"requiredFields":["realContactOrSupportChannel","whoActuallyReceivesTheContact"],"relationship":"Publisher support is not falsely labelled as this site's operator"},
    {"id":"information.privacy","pages":["information"],"when":"privacy","required":true,"requiredFields":["actualSiteDataBehaviour","realExternalDependencies","knownHostingLimits"]},
    {"id":"information.disclaimer","pages":["information"],"when":"disclaimer","required":true,"requiredFields":["actualEditorialAndPublisherBoundary","factSnapshotAndChannelLimits"]},
    {"id":"information.not-found","pages":["information"],"when":"not-found","required":true,"requiredFields":["actualUnknownRouteState","workingRecovery","observedServerBehaviour"]}
  ]
}
