      "author",
      "reviewer"
    ],
    "neverImportImplicitly": [
      "Coupon business rules",
      "Games browser-runtime rules",
      "reference advertising/scripts",
      "unscoped shared experience"
    ],
    "relativeTo": "package-root"
  },
  "common": [
