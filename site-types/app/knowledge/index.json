        "review",
        "tutorial",
        "collection",
        "comparison"
      ]
    },
    "category": {
      "status": "active",
      "required": true,
      "path": "pages/category.md",
      "moduleRule": "APP-CATEGORY-001",
      "optionalOverview": true
    },
    "detail": {
      "status": "active",
      "required": true,
      "path": "pages/detail.md",
      "moduleRule": "APP-DETAIL-001"
    },
    "version": {
      "status": "active",
      "required": true,
      "path": "pages/version.md",
      "moduleRule": "APP-VERSION-001",
      "meaning": "download-handoff",
      "optionalHistory": true
    },
    "search": {
      "status": "active",
      "required": false,
      "path": "pages/search.md",
      "moduleRule": "APP-SEARCH-001",
      "when": "search-enabled"
    },
    "information": {
      "status": "active",
      "required": true,
      "path": "pages/information.md",
      "moduleRule": "APP-INFO-001",
      "requiredKinds": [
        "about",
        "contact",
        "privacy",
        "disclaimer",
        "not-found"
      ],
      "optionalKinds": [
        "terms"
      ]
    }
