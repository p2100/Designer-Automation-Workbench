      "status": "active",
      "path": "core/quality.md",
      "roles": [
        "author",
        "reviewer"
      ]
    },
    {
      "id": "data-and-channels",
      "status": "active",
      "path": "core/data-and-channels.md",
      "roles": [
        "author",
        "reviewer"
      ]
    },
    {
      "id": "module-data",
      "status": "active",
      "path": "core/module-data.md",
      "roles": [
        "author",
        "reviewer"
      ]
    },
    {
      "id": "workflow",
      "status": "active",
      "path": "core/workflow.md",
      "roles": [
        "author",
        "reviewer"
      ]
    },
    {
      "id": "information-route-inventory",
      "status": "active",
      "path": "pages/information.md",
      "roles": [
        "author",
        "reviewer"
      ],
      "note": "Site-level APP-INFO-001 always applies; the remaining clauses apply to their information kinds"
    },
    {
      "id": "review-method",
      "status": "active",
      "path": "core/review.md",
      "roles": [
        "reviewer"
      ]
    }
  ],
  "conditional": [
    {
      "id": "search-feature",
      "status": "active",
      "path": "pages/search.md",
      "roles": [
        "author",
        "reviewer"
      ],
      "when": "search-enabled-or-search-entry-shown",
      "note": "Also load for an embedded search panel without a separate search route"
    }
  ],
  "pages": {
    "home": {
      "status": "active",
      "required": true,
      "path": "pages/home.md",
      "moduleRule": "APP-HOME-001"
    },
    "article": {
      "status": "active",
      "required": true,
      "path": "pages/article.md",
      "moduleRule": "APP-ARTICLE-001",
